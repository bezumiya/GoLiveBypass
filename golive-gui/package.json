{
  "name": "golive-gui",
  "private": true,
  "version": "2.0.6-beta-2",
  "desktopName": "com.golivebypass.gui.desktop",
  "description": "Devolve o Go Live e a camera do Discord para contas que cairam no bloqueio regional brasileiro",
  "author": "bezumiya",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "compile": "node scripts/sync-bypass.mjs && npm run build:proton && tsc && vite build",
    "build:proton": "node scripts/build-proton.mjs",
    "build": "npm run compile && electron-builder --publish never",
    "build:win": "npm run compile && electron-builder --win --x64 --publish never",
    "build:mac": "npm run compile && electron-builder --mac --arm64 --publish never",
    "preview": "vite preview",
    "sync-bypass": "node scripts/sync-bypass.mjs",
    "check-bypass": "node scripts/sync-bypass.mjs --check",
    "test": "vitest run",
    "build:linux": "npm run compile && electron-builder --linux AppImage --publish never",
    "publish:win": "npm run compile && electron-builder --win --x64 --publish always",
    "publish:mac": "npm run compile && electron-builder --mac --arm64 --publish always",
    "publish:linux": "npm run compile && electron-builder --linux AppImage --publish always"
  },
  "build": {
    "appId": "com.golivebypass.gui",
    "productName": "GoLiveBypass",
    "publish": {
      "provider": "github",
      "owner": "bezumiya",
      "repo": "GoLiveBypass",
      "releaseType": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "assets"
    ],
    "directories": {
      "output": "dist-app"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "../standalone",
        "to": "extra/standalone",
        "filter": [
          "golivebypass-standalone.sh"
        ]
      },
      {
        "from": "../tools/proton-confgen/build",
        "to": "extra/proton-confgen"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "category": "public.app-category.utilities",
      "artifactName": "${productName}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}

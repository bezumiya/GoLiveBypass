# Obrigatorias
GITHUB_TOKEN=ghp_cole_aqui_o_fine_grained_pat
API_TOKEN=gerar_um_segredo_compartilhado
GITHUB_WEBHOOK_SECRET=gerar_outro_segredo_para_o_webhook

# Opcionais
GITHUB_REPO=bezumiya/GoLiveBypass
# Labels precisam existir no repo. Crie "gui" uma vez (Settings → Labels).
ISSUE_LABELS=bug,gui
PORT=8080
# Rate limit agressivo: quantos requests por minuto por IP (janela de 1min).
# Estourar a janela BLOQUEIA o IP por BLOCK_SECONDS.
RATE_LIMIT=10
BLOCK_SECONDS=300
MAX_LOG_BYTES=262144
LOG_LEVEL=info
# Prefixo de rota quando a API fica atras de um proxy por path (ex.: /bugs).
# Vazio = servir na raiz.
BASE_PATH=
